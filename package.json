{
  "name": "savepoint",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/prepare-standalone.mts",
    "dev:turbo": "next dev",
    "build:turbo": "next build && node scripts/prepare-standalone.mts",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-env": "node scripts/check-env.ts",
    "verify-schema": "node scripts/verify-schema.mts",
    "igdb:smoke-test": "node scripts/igdb-smoke-test.mts",
    "verify-standalone": "node scripts/smoke-test-standalone.mts",
    "pinecone:bootstrap": "node scripts/pinecone-bootstrap.mts",
    "pinecone:backfill": "node scripts/pinecone-backfill.mts",
    "pinecone:smoke-test": "node scripts/pinecone-smoke-test.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@pinecone-database/pinecone": "^8.2.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.16.2",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
