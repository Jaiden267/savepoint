# Savepoint environment variable contract.
# Copy to .env.local and fill in real values. NEVER commit real values.
# Names only below — no secrets in this file.

# --- Client-safe (exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional, defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL=

# --- Server-only (never exposed to the browser) ---
SUPABASE_SECRET_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
PINECONE_API_KEY=
# Optional, defaults to savepoint-games
PINECONE_INDEX_NAME=
# Optional, comma-separated Supabase user IDs granted admin tooling access
ADMIN_USER_IDS=
# Optional, added later to guard the cron refresh endpoint
CRON_SECRET=

# NOTE: The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# variables are intentionally NOT used by this project.
